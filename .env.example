COMPOSE_PROJECT_NAME=rag-platform

# 阿里云百炼：复制为 .env 后填写。不要提交真实密钥。
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_NAME=qwen-plus
ALIYUN_EMBED_MODEL_NAME=text-embedding-v4
ALIYUN_RERANKER_MODEL_NAME=qwen3-vl-rerank

# 可选：Docker 容器访问外网所用的宿主机代理。
# Clash Verge 用户可填写：http://host.docker.internal:7897
OUTBOUND_PROXY=

# 本地开发凭据：首次启动前必须修改。
MYSQL_ROOT_PASSWORD=change-me-mysql
JWT_SECRET_KEY=change-me-jwt-at-least-32-characters
MINIO_ROOT_USER=ragadmin
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-characters

# Windows 宿主端口；项目 MySQL 使用 3307，避免与 MySQL80 冲突。
FRONT_PORT=3000
API_PORT=8000
DJANGO_PORT=8001
MYSQL_PORT_HOST=3307
REDIS_PORT_HOST=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_PORT=19530
ATTU_PORT=8080
PORTAINER_PORT=9443

